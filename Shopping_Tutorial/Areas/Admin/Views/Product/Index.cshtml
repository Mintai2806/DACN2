@model IEnumerable<ProductModel>
@{
    ViewData["Title"] = "List Product";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>List Products</h3>
        <a class="btn btn-primary" asp-action="Create" asp-controller="Product">
            <i class="fa fa-plus"></i> Add Product
        </a>
    </div>

    <table class="table table-striped table-bordered table-hover align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Sold</th>
                <th>Description</th>
                <th>Sell Price</th>
                <th>Capital Price</th>
                <th>Image</th>
                <th>Slug</th>
                <th>Category</th>
                <th>Brand</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1; // biến đếm thứ tự
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@index</td>
                    <td class="text-start">@item.Name</td>
                    <td>
                        <b>@item.Quantity</b><br />
                        <a asp-controller="Product" asp-action="AddQuantity" asp-route-Id="@item.Id">Add Quantity</a>
                    </td>
                    <td><b>@item.Sold</b></td>
                    <td class="text-start">@Html.Raw(item.Description)</td>
                    <td>@item.Price.ToString("#,##0 VNĐ")</td>
                    <td>@item.CapitalPrice.ToString("#,##0 VNĐ")</td>
                    <td>
                        <img src="~/media/products/@item.Image" alt="@item.Name"
                             class="img-fluid" style="max-width:120px; max-height:150px;" />
                    </td>
                    <td>@item.Slug</td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Brand?.Name</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" asp-action="Edit" asp-controller="Product" asp-route-Id="@item.Id">
                            <i class="fa fa-edit"></i> Edit
                        </a>
                        <a class="btn btn-danger btn-sm confirmDeletion" asp-action="Delete" asp-controller="Product" asp-route-Id="@item.Id">
                            <i class="fa fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
                index++;
            }
        </tbody>
    </table>
</div>
