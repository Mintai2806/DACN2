@{
    ViewData["title"] = "List Compare";
    var key = 0;
}

<div class="container py-5">
    <h3 class="mb-4">List Compare</h3>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr class="text-center">
                    <th>#</th>
                    <th>Product Name</th>
                    <th>Product Description</th>
                    <th>Product Price</th>
                    <th>Product Image</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var compare_product in Model)
                {
                    key++;
                    <tr>
                        <td class="text-center">@key</td>
                        <td>@compare_product.Product.Name</td>
                        <td>@Html.Raw(compare_product.Product.Description)</td>
                        <td class="text-end">@compare_product.Product.Price.ToString("#,##0 VNĐ")</td>
                        <td class="text-center">
                            <img src="~/media/products/@compare_product.Product.Image"
                                 class="img-fluid"
                                 style="max-width: 120px; max-height: 150px;" />
                        </td>
                        <td class="text-center">
                            <a class="btn btn-danger btn-sm confirmDeletion"
                               asp-action="DeleteCompare"
                               asp-controller="Home"
                               asp-route-Id="@compare_product.Compares.Id">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
