@model IEnumerable<OrderModel>

@{
    ViewData["title"] = "List History Orders placed by " + ViewBag.UserEmail;
    var key = 0; // biến đếm
}

<div class="container py-5">
    <h3 class="mb-4">List History Orders placed by @ViewBag.UserEmail</h3>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>#</th>
                    <th>Order Code</th>
                    <th>Shipping Cost</th>
                    <th>Coupon Code</th>
                    <th>UserName</th>
                    <th>Order Status</th>
                    <th>Payment Method</th>
                    <th>Created Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    key++;
                      <!-- tăng Id tự động -->
                    <tr>
                        <td class="text-center">@key</td>
                        <td>@item.OrderCode</td>
                        <td class="text-end">@item.ShippingCost.ToString("#,##0 VNĐ")</td>
                        <td>@item.CouponCode</td>
                        <td>@item.UserName</td>
                        <td class="text-center">
                            @if (item.Status == 1)
                            {
                                <span class="text-success">Đơn hàng mới</span>
                            }
                            else if (item.Status == 0)
                            {
                                <span class="text-primary">Đã hoàn thành</span>
                            }
                            else
                            {
                                <span class="text-danger">Đã hủy</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.PaymentMethod == "COD")
                            {
                                <span class="text-primary">@item.PaymentMethod</span>
                            }
                            else
                            {
                                <span class="text-success">@item.PaymentMethod</span>
                            }
                        </td>
                        <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            @if (item.Status != 3)
                            {
                                <a class="btn btn-danger btn-sm"
                                   onclick="return confirm('Xác nhận hủy đơn?')"
                                   asp-action="CancelOrder"
                                   asp-controller="Account"
                                   asp-route-ordercode="@item.OrderCode">
                                    Cancel Order
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
